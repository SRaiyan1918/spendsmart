// LOCAL EMULATOR ONLY. This file is not a production rules deployment.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{collection}/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
